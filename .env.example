# Copy to .env.local and fill in when the live price API is available.
# All variables are optional; defaults are in src/config/liveApiConfig.ts.

# Base URL of the live price API (no trailing slash needed).
VITE_LIVE_API_BASE_URL=https://api.market-watch.example/v1

# Sent as "Authorization: Bearer <key>" when set.
# VITE_LIVE_API_KEY=

# Request timeout in milliseconds.
# VITE_LIVE_API_TIMEOUT_MS=10000
