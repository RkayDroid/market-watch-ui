# Copy to .env.local and fill in to use the live stock API.
# All variables are optional; defaults are in src/config/liveApiConfig.ts.

# Base URL of the live stock API (no trailing slash needed).
# Lookups call GET {VITE_LIVE_API_BASE_URL}/stock/{SYMBOL}; Performance in "Past Performance" calls
# .../stock/{SYMBOL}/historic?period={PERIOD}[&referenceDate=YYYY-MM-DD] (whose candles also provide the
# period's high/low).
VITE_LIVE_API_BASE_URL=https://api.market-watch.example/v1

# Sent as "Authorization: Bearer <key>" when set.
# VITE_LIVE_API_KEY=

# Request timeout in milliseconds.
# VITE_LIVE_API_TIMEOUT_MS=10000

# User the watchlist API stores lists for (POST /watchlist "userId"). Placeholder until sign-in exists.
# VITE_USER_ID=anonymous
